# ============================================
# Retro Terminal Config
# CRT aesthetic, vintage vibes
# ============================================

working-directory = home

# Classic terminal size
window-width = 80
window-height = 24

# Retro green screen theme
theme = Adventure

# Monospace font
font-family = JetBrains Mono
font-size = 14

# Slight bloom effect with transparency
background-opacity = 0.95
background-blur = 5

# Minimal padding (authentic terminal feel)
window-padding-x = 8
window-padding-y = 8

# Block cursor (classic)
cursor-style = block
cursor-style-blink = true

# Behavior
confirm-close-surface = true
mouse-hide-while-typing = true
scrollback-limit = 10000

# Shell integration
shell-integration = detect

# NOTE: For CRT shader effects, Ghostty supports custom GLSL shaders!
# Create a shader file and reference it with:
# custom-shader = ~/.config/ghostty/shaders/crt.glsl
# custom-shader-animation = true

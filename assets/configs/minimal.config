# ============================================
# Minimal Ghostty Config
# Fast, clean, no transparency
# ============================================

working-directory = home

# Window size
window-width = 100
window-height = 50

# Theme - clean and simple
theme = Atom One Dark

# Font
font-family = JetBrains Mono
font-size = 14

# No transparency for performance
background-opacity = 1.0

# Minimal padding
window-padding-x = 4
window-padding-y = 4

# Behavior
confirm-close-surface = true
mouse-hide-while-typing = true
scrollback-limit = 50000

# Shell integration
shell-integration = detect

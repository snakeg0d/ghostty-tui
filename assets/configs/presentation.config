# ============================================
# Presentation Mode Config
# Large fonts, high contrast for demos
# ============================================

working-directory = home

# Larger window
window-width = 120
window-height = 40

# High contrast theme
theme = Atom One Dark

# LARGE font for visibility
font-family = JetBrains Mono
font-size = 20

# No transparency - better for screen sharing
background-opacity = 1.0

# Extra padding for clean look
window-padding-x = 20
window-padding-y = 20

# Behavior
confirm-close-surface = true
mouse-hide-while-typing = true
scrollback-limit = 10000

# Shell integration
shell-integration = detect

# ============================================
# Gruvbox MonoLisa Config
# Clean, focused setup with premium typography
# ============================================

# ============================================
# APPEARANCE
# ============================================

theme = GruvboxDarkHard

# Window size
window-height = 30
window-width = 110

# Title
title = "Mac OS X Terminal"

# Font - MonoLisa Variable
window-title-font-family = "MonoLisa Variable"
font-family = "MonoLisa Variable"
font-size = 12

# Font features (disable ligatures and contextual alternates)
font-feature = -liga
font-feature = -calt
font-feature = -dlig
font-thicken = true

# Cell adjustments
adjust-cell-height = 9%

# ============================================
# BEHAVIOR
# ============================================

# Mouse
mouse-scroll-multiplier = 0.5

# Clipboard
copy-on-select = clipboard

# Shell integration (no cursor feature)
shell-integration-features = no-cursor

# ============================================
# MACOS-SPECIFIC
# ============================================

macos-titlebar-style = tabs

# ============================================
# TRANSPARENCY & BLUR
# ============================================

background-opacity = 0.90
background-blur-radius = 20

# ============================================
# CURSOR
# ============================================

cursor-style = block
cursor-style-blink = true
cursor-invert-fg-bg = true
cursor-opacity = 0.8

# ============================================
# COLORS
# ============================================

# Selection
selection-invert-fg-bg = true

# Bold
bold-is-bright = true

# Contrast
minimum-contrast = 2

# ============================================
# WINDOW PADDING
# ============================================

window-padding-x = 15
window-padding-y = 10

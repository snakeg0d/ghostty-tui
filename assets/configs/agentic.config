# ============================================
# Ghostty Config - Agentic Command Center
# Optimized for AI-assisted development
# ============================================

# Default working directory (use `home` literal, or an absolute path like `~/dev`)
working-directory = home

# ============================================
# WINDOW SIZE - Optimized for TUI apps
# ============================================

# Large enough for gostty (77x41) and other TUI tools
window-width = 100
window-height = 50

# ============================================
# KEYBINDS - Quick Project Access
# ============================================

# Shift+Enter = send escape sequence (useful for some CLIs)
keybind = shift+enter=text:\x1b\r

# New windows in specific directories — edit to taste
# Ghostty expands `~` in keybind paths.
# keybind = cmd+shift+d=new_window:working-directory=~/dev
# keybind = cmd+shift+p=new_window:working-directory=~/dev/projects
# keybind = cmd+shift+s=new_window:working-directory=~/scratch

# ============================================
# APPEARANCE - Glass Aesthetic
# ============================================

# Glass blur effect
background-blur = 20
background-opacity = 0.95

# Theme
theme = Dracula

# Font
font-family = JetBrains Mono
font-size = 14

# Window padding
window-padding-x = 12
window-padding-y = 12

# ============================================
# BEHAVIOR
# ============================================

# Confirm before closing window with running processes
confirm-close-surface = true

# Mouse
mouse-hide-while-typing = true

# Scrollback
scrollback-limit = 50000

# ============================================
# TABS & WINDOWS
# ============================================

# Show working directory in tab title
title = working-directory

# Auto-hide tab bar when only one tab
window-show-tab-bar = auto

# ============================================
# SHELL INTEGRATION
# ============================================

# Auto-inject shell integration features
shell-integration = detect
shell-integration-features = cursor,sudo,title

# ============================================
# CLIPBOARD & SELECTION
# ============================================

# Copy on select
copy-on-select = true

# Trim whitespace when copying
clipboard-trim-trailing-spaces = true

# Paste protection (confirm dangerous pastes)
clipboard-paste-protection = true

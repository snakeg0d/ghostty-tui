# ============================================
# aecsar's Wide Window Config
# Ultra-wide terminal (200 cols!)
# Source: https://github.com/aecsar/dotfiles
# ============================================

# ============================================
# THEME
# ============================================

theme = light:TokyoNight,dark:TokyoNight

# ============================================
# FONT
# ============================================

font-family = "JetBrainsMono Nerd Font Mono"
font-size = 17

font-style = SemiBold
font-style-bold = Bold
font-style-italic = SemiBold Italic
font-style-bold-italic = Bold Italic

# ============================================
# WINDOW SIZE
# ============================================

# Ultra-wide setup
window-height = 50
window-width = 200

# ============================================
# CURSOR
# ============================================

adjust-cursor-thickness = 80%
cursor-text = 000
cursor-color = FFF

# ============================================
# MACOS
# ============================================

macos-titlebar-style = tabs
macos-icon = xray
macos-option-as-alt = left

# ============================================
# BEHAVIOR
# ============================================

window-save-state = always

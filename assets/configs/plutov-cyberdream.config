# ============================================
# plutov's Cyberdream Config
# Custom Cyberdream color theme
# Source: https://github.com/plutov/dotfiles
# ============================================

# ============================================
# FONT
# ============================================

font-family = "JetBrains Mono"
window-title-font-family = "JetBrains Mono"
font-size = 12

# Disable ligatures
font-feature = -calt
font-feature = -liga
font-feature = -dlig

# ============================================
# SHELL
# ============================================

shell-integration-features = ssh-env

# ============================================
# BEHAVIOR
# ============================================

clipboard-paste-protection = false
confirm-close-surface = false
window-save-state = always

# ============================================
# WINDOW
# ============================================

window-padding-x = 4
window-padding-y = 4
window-padding-balance = true
window-decoration = auto

# Split divider
split-divider-color = "#ffffff"

# ============================================
# MACOS
# ============================================

macos-option-as-alt = true

# ============================================
# CYBERDREAM THEME
# ============================================

# Standard colors
palette = 0=#16181a
palette = 1=#ff6e5e
palette = 2=#5eff6c
palette = 3=#f1ff5e
palette = 4=#5ea1ff
palette = 5=#bd5eff
palette = 6=#5ef1ff
palette = 7=#ffffff

# Bright colors
palette = 8=#3c4048
palette = 9=#ff6e5e
palette = 10=#5eff6c
palette = 11=#f1ff5e
palette = 12=#5ea1ff
palette = 13=#bd5eff
palette = 14=#5ef1ff
palette = 15=#ffffff

# Base colors
background = #16181a
foreground = #ffffff
cursor-color = #ffffff
selection-background = #3c4048
selection-foreground = #ffffff

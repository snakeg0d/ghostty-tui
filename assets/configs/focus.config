# ============================================
# Focus Mode Config
# Distraction-free, centered, minimal UI
# ============================================

working-directory = home

# Standard size
window-width = 100
window-height = 50

# Dark, neutral theme
theme = Adventure Time

# Font
font-family = JetBrains Mono
font-size = 14

# Subtle transparency
background-opacity = 0.98
background-blur = 10

# Generous padding for centered feel
window-padding-x = 40
window-padding-y = 20

# Hide decorations for clean look
window-decoration = false

# Hide tabs when single tab
window-show-tab-bar = never

# Behavior
confirm-close-surface = false
mouse-hide-while-typing = true
scrollback-limit = 50000

# Shell integration
shell-integration = detect
